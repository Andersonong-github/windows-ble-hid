<Page x:Class="BleHid.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Settings">

  <StackPanel Margin="24,0,24,24">

    <ui:TextBlock Text="Settings" FontTypography="TitleLarge" Margin="0,0,0,4" />
    <ui:TextBlock Text="Control how BLE HID starts and what happens when the window is closed."
                  FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" Margin="0,0,0,20" />

    <ui:InfoBar x:Name="DevBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                Title="Auto-start unavailable"
                Message="Run the published executable rather than 'dotnet run' to register auto-start." />

    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start with Windows" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Launches hidden in the notification area when you sign in." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Start the peripheral automatically" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Begins advertising as soon as the app launches." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding StartPeripheralOnLaunch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Keep running when the window is closed" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Paired hosts reconnect to a peripheral that never restarted, so staying resident keeps them working." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Cursor24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Shake the pointer to switch target" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Move the mouse rapidly back and forth to cycle between this PC and the paired hosts. The hotkeys below always work too, and the touchpad is left untouched while input stays local." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="SwitchGestureToggle" Click="OnSwitchGestureChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Switch targets from the keyboard" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap" Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Ctrl+Alt+CapsLock cycles through this PC and the paired hosts. Ctrl+Alt+1…9 selects a host directly, Ctrl+Alt+0 returns here, and Ctrl+Alt+Q stops capture. Ctrl+D+C still cycles as an alternative." />
        </StackPanel>
      </ui:CardControl.Header>
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Bug24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Log every captured key" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Writes each key's virtual key, scan code and resulting HID usages to the activity log. Leave this off unless you are diagnosing a key that does not arrive on the host." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding LogKeyDiagnostics, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowExit20}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="Exit BLE HID" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Stops advertising and removes the tray icon. Hosts will need to reconnect." />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button Content="Exit" Click="OnExit" />
    </ui:CardControl>

  </StackPanel>
</Page>
